# Public website assistant — all values are server-side Netlify variables.
# The assistant remains absent unless this is exactly "true".
MORTGAGE_ASSISTANT_ENABLED=false

# Generate independent high-entropy values. Never expose these to browser code.
MORTGAGE_ASSISTANT_SESSION_SECRET=replace-with-at-least-32-random-bytes
LOANOS_ASSISTANT_SIGNING_SECRET=replace-with-a-different-32-byte-secret
LOANOS_ASSISTANT_KEY_ID=styermortgage-staging-v1

# Staging LoanOS base URL. No trailing slash.
LOANOS_ASSISTANT_URL=https://replace-with-loanos-staging.example
# Optional for protected Vercel preview deployments. Keep server-side only.
LOANOS_ASSISTANT_BYPASS_TOKEN=replace-with-vercel-automation-bypass-secret

# Server-side OpenAI project key and an explicitly reviewed model.
OPENAI_API_KEY=replace-with-staging-project-key
OPENAI_MORTGAGE_ASSISTANT_MODEL=gpt-5.6-luna

# Reviewed, date-stamped server-side market ranges. See docs/website-assistant.md.
# Keep this disabled or unset until every range, date, source, and cost structure
# has been reviewed. Never place this JSON in browser code.
MORTGAGE_ASSISTANT_RATE_MARKET_JSON=replace-with-reviewed-server-side-json

# Reviewed planning assumptions for taxes, insurance, PMI, and closing costs.
# The assistant declines to produce a total estimate when this is missing,
# disabled, invalid, or expired.
MORTGAGE_ASSISTANT_ESTIMATE_ASSUMPTIONS_JSON=replace-with-reviewed-server-side-json

# Read-only Google Search Console snapshots used by scheduled SEO reporting.
# Prefer a protected local file outside the repository. The snapshot script
# defaults to ~/.config/styermortgage/gsc-service-account.json. A protected
# JSON environment value is also supported for CI. Never commit the credential.
GSC_SITE_URL=https://styermortgage.com/
GSC_SERVICE_ACCOUNT_FILE=/absolute/path/to/gsc-service-account.json
# GSC_SERVICE_ACCOUNT_JSON=replace-with-read-only-service-account-json
