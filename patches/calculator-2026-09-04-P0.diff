# the static accessible-name audit and live Lighthouse (axe `label` audit) — same 5.
# aria-label text mirrors each control's visible label.
# (The other 6 wrap inputs gained aria-labels since the 06-29 audit — 16 -> 5 open.)
################################################################################

FILE: wrap-mortgage-calculator.html

FIND:
                <input type="number" id="w-existing-rate" value="3" min="0" max="15" step="0.125" style="width:100%; padding: .5rem; border: 1px solid var(--color-border); border-radius: 8px;">

REPLACE:
                <input type="number" id="w-existing-rate" aria-label="Existing loan interest rate percent" value="3" min="0" max="15" step="0.125" style="width:100%; padding: .5rem; border: 1px solid var(--color-border); border-radius: 8px;">

FIND:
                <input type="number" id="w-closing-pct" value="8" min="0" max="15" step="0.5" style="width:100%; padding: .5rem; border: 1px solid var(--color-border); border-radius: 8px;">

REPLACE:
                <input type="number" id="w-closing-pct" aria-label="Closing costs percent" value="8" min="0" max="15" step="0.5" style="width:100%; padding: .5rem; border: 1px solid var(--color-border); border-radius: 8px;">

FIND:
                <input type="number" id="w-wrap-rate" value="6.5" min="0" max="15" step="0.125" style="width:100%; padding: .5rem; border: 1px solid var(--color-border); border-radius: 8px;">

REPLACE:
                <input type="number" id="w-wrap-rate" aria-label="Wrap loan interest rate percent" value="6.5" min="0" max="15" step="0.125" style="width:100%; padding: .5rem; border: 1px solid var(--color-border); border-radius: 8px;">

