################################################################################
# P0-3b — refinance-calculator.html (2 edits)
# 1) The escrow on/off switch is a checkbox inside a text-free <label class="switch">
#    — accessible name is EMPTY, so a screen reader announces only "checkbox".
# 2) The read-only Computed Per-Diem display field's <label> has no `for` attribute.
################################################################################

FILE: refinance-calculator.html

FIND:
          <input type="checkbox" id="escrow-toggle" checked>

REPLACE:
          <input type="checkbox" id="escrow-toggle" aria-label="Include escrows in payment" checked>

FIND:
          <input type="text" id="computed-perdiem" readonly tabindex="-1" style="background:#f8fafc;color:var(--text-muted);">

REPLACE:
          <input type="text" id="computed-perdiem" aria-label="Computed per-diem interest" readonly tabindex="-1" style="background:#f8fafc;color:var(--text-muted);">

################################################################################
# P0-4 — assistant-widget.js (1 edit)  [sitewide element, surfaced on calc pages]
# assistant-widget.css:15 hides the launcher's text span at <=1600px
# (`.ma-launcher span:last-child{display:none}`) and the remaining icon span is
# aria-hidden — so on virtually every real screen the floating assistant button has
# NO accessible name. Lighthouse `button-name` fails on every audited calc page.
# A static aria-label also hardens the professionalMode text variant.
################################################################################

FILE: assistant-widget.js

FIND:
      '<button class="ma-launcher" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="mortgage-assistant-panel">',

REPLACE:
      '<button class="ma-launcher" type="button" aria-label="Open mortgage assistant" aria-haspopup="dialog" aria-expanded="false" aria-controls="mortgage-assistant-panel">',

# END OF PATCH — 11 edits, 4 files. No math, no form names, no GTM, no tracking touched.
