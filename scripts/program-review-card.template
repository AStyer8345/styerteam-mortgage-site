<div class="journey-field" data-goals="Purchase|Invest|Build|Buy before selling"><label for="business_owner-down_payment">Estimated down payment</label><input id="business_owner-down_payment" name="down_payment" type="text" maxlength="160" placeholder="Estimate or leave unknown"></div>
<div class="journey-field" data-goals="Refinance|Access equity|Buy before selling"><label for="business_owner-current_balance">Current mortgage balance</label><input id="business_owner-current_balance" name="current_balance" type="text" maxlength="160" placeholder="Estimate or leave unknown"></div>
<div class="journey-field" data-goals="Refinance|Access equity"><label for="business_owner-current_rate">Current interest rate (%)</label><input id="business_owner-current_rate" name="current_rate" type="text" maxlength="160" placeholder="Estimate or leave unknown"></div>
<div class="journey-field" data-goals="Refinance|Access equity"><label for="business_owner-refinance_goal">What would you like to change?</label><select id="business_owner-refinance_goal" name="refinance_goal"><option value="">Choose or leave unknown</option><option value="Lower payment">Lower payment</option><option value="Compare rate and costs">Compare rate and costs</option><option value="Change loan term">Change loan term</option><option value="Use equity">Use equity</option><option value="Still deciding">Still deciding</option></select></div>
<div class="journey-field" data-goals="Invest"><label for="business_owner-investment_action">What is the investment plan?</label><select id="business_owner-investment_action" name="investment_action"><option value="">Choose or leave unknown</option><option value="Purchase">Purchase</option><option value="Refinance">Refinance</option><option value="Access equity">Access equity</option><option value="Still deciding">Still deciding</option></select></div>
<div class="journey-field" data-goals="Invest"><label for="business_owner-property_type">Property type</label><select id="business_owner-property_type" name="property_type"><option value="">Choose or leave unknown</option><option value="Single-family rental">Single-family rental</option><option value="Condo or townhome">Condo or townhome</option><option value="2–4 units">2–4 units</option><option value="5+ units / commercial">5+ units / commercial</option><option value="Not sure yet">Not sure yet</option></select></div>
<div class="journey-field" data-goals="Invest"><label for="business_owner-monthly_rent">Expected or current monthly rent</label><input id="business_owner-monthly_rent" name="monthly_rent" type="text" maxlength="160" placeholder="Estimate or leave unknown"></div>
<div class="journey-field" data-goals="Invest"><label for="business_owner-investment_strategy">Investment strategy</label><select id="business_owner-investment_strategy" name="investment_strategy"><option value="">Choose or leave unknown</option><option value="Long-term rental">Long-term rental</option><option value="Short-term rental">Short-term rental</option><option value="Fix and flip">Fix and flip</option><option value="BRRRR / renovate and rent">BRRRR / renovate and rent</option><option value="Portfolio growth">Portfolio growth</option><option value="Still deciding">Still deciding</option></select></div>
<div class="journey-field" data-situations="Self-employed / business owner"><label for="business_owner-time_in_business">Time in business</label><select id="business_owner-time_in_business" name="time_in_business"><option value="">Choose or leave unknown</option><option value="Less than 1 year">Less than 1 year</option><option value="1–2 years">1–2 years</option><option value="2 or more years">2 or more years</option><option value="Not sure">Not sure</option></select></div>
<div class="journey-field" data-situations="Self-employed / business owner|Substantial assets"><label for="business_owner-documentation_issue">Income or documentation question</label><input id="business_owner-documentation_issue" name="documentation_issue" type="text" maxlength="160" placeholder="Estimate or leave unknown"></div>
<div class="journey-field" data-situations="Difficulty with another lender"><label for="business_owner-lender_status">Current loan stage</label><select id="business_owner-lender_status" name="lender_status"><option value="">Choose or leave unknown</option><option value="Just started">Just started</option><option value="Application submitted">Application submitted</option><option value="Processing">Processing</option><option value="Underwriting">Underwriting</option><option value="Approved with conditions">Approved with conditions</option><option value="Clear to close">Clear to close</option><option value="Not sure">Not sure</option></select></div>
<div class="journey-field" data-situations="Difficulty with another lender"><label for="business_owner-closing_date">Closing date or deadline</label><input id="business_owner-closing_date" name="closing_date" type="text" maxlength="160" placeholder="Estimate or leave unknown"></div>
<div class="journey-field" data-situations="Difficulty with another lender"><label for="business_owner-switch_reason">Reason for considering a different lender</label><input id="business_owner-switch_reason" name="switch_reason" type="text" maxlength="160" placeholder="Estimate or leave unknown"></div>
<div class="journey-field" data-goals="Build"><label for="business_owner-lot_status">Where are you with the lot?</label><select id="business_owner-lot_status" name="lot_status"><option value="">Choose or leave unknown</option><option value="Still looking">Still looking</option><option value="Lot identified">Lot identified</option><option value="Under contract">Under contract</option><option value="Already own the lot">Already own the lot</option><option value="Not sure">Not sure</option></select></div>
<div class="journey-field" data-goals="Build"><label for="business_owner-builder_status">Builder status</label><select id="business_owner-builder_status" name="builder_status"><option value="">Choose or leave unknown</option><option value="Still comparing">Still comparing</option><option value="Builder selected">Builder selected</option><option value="Plans / bid in progress">Plans / bid in progress</option><option value="Contract signed">Contract signed</option><option value="Not sure">Not sure</option></select></div>
<div class="journey-field" data-goals="Build"><label for="business_owner-project_budget">Estimated total project budget</label><input id="business_owner-project_budget" name="project_budget" type="text" maxlength="160" placeholder="Estimate or leave unknown"></div>
<div class="journey-field" data-goals="Build"><label for="business_owner-build_timing">When would you like to start building?</label><input id="business_owner-build_timing" name="build_timing" type="text" maxlength="160" placeholder="Estimate or leave unknown"></div>
<div class="journey-field" data-goals="Buy before selling"><label for="business_owner-current_home_value">Approximate current-home value</label><input id="business_owner-current_home_value" name="current_home_value" type="text" maxlength="160" placeholder="Estimate or leave unknown"></div>
<div class="journey-field" data-goals="Buy before selling"><label for="business_owner-listing_status">Current-home status</label><select id="business_owner-listing_status" name="listing_status"><option value="">Choose or leave unknown</option><option value="Not listed">Not listed</option><option value="Preparing to list">Preparing to list</option><option value="Listed for sale">Listed for sale</option><option value="Under contract">Under contract</option><option value="Sold">Sold</option></select></div>
<div class="journey-field" data-goals="Buy before selling"><label for="business_owner-primary_constraint">What is the main constraint?</label><select id="business_owner-primary_constraint" name="primary_constraint"><option value="">Choose or leave unknown</option><option value="Down payment tied up in equity">Down payment tied up in equity</option><option value="Qualifying with both payments">Qualifying with both payments</option><option value="Avoiding two moves">Avoiding two moves</option><option value="Avoiding a sale contingency">Avoiding a sale contingency</option><option value="Uncertain timing">Uncertain timing</option><option value="Something else">Something else</option></select></div>
<div class="journey-field"><label for="business_owner-timeline">Your timing or next milestone</label><input id="business_owner-timeline" name="timeline" type="text" maxlength="160" placeholder="Estimate or leave unknown"></div></div><button type="button" class="journey-button journey-submit" data-journey-next hidden>Continue</button></fieldset>
        <fieldset data-journey-step="2"><legend>How can Adam reach you?</legend>
          <div class="journey-fields">
            <div class="journey-field"><label for="business_owner-first">First name *</label><input id="business_owner-first" name="first_name" autocomplete="given-name" required maxlength="80"></div>
            <div class="journey-field"><label for="business_owner-last">Last name *</label><input id="business_owner-last" name="last_name" autocomplete="family-name" required maxlength="80"></div>
            <div class="journey-field"><label for="business_owner-email">Email *</label><input id="business_owner-email" name="email" type="email" autocomplete="email" required maxlength="160"></div>
            <div class="journey-field"><label for="business_owner-phone">Phone (optional)</label><input id="business_owner-phone" name="phone" type="tel" autocomplete="tel" maxlength="30"></div>
            <div class="journey-field journey-full"><label for="business_owner-context">Anything else Adam should know? (optional)</label><textarea id="business_owner-context" name="situation" rows="3" maxlength="2000" placeholder="Share your goals, questions, or anything that affects your plans."></textarea><p class="journey-hint">Please leave out Social Security numbers, account numbers, and sensitive documents.</p></div>
          </div>
          <label class="journey-consent"><input type="checkbox" name="tcpa_consent" required><span>I agree to be contacted by Adam Styer via phone, email, or text about mortgage options. Consent is not a condition of purchase. Msg &amp; data rates may apply. Reply STOP to opt out. *</span></label>
          <div class="journey-field"><label for="business_owner-follow-up">How would you prefer to hear from me?</label><select id="business_owner-follow-up" name="preferred_follow_up"><option value="Email">Email</option><option value="Phone">Phone</option></select><p class="journey-hint">For a time-sensitive question, you can also <a href="sms:+15129566010">text Adam</a>.</p></div><div class="journey-form-actions"><button type="button" class="journey-back" data-journey-back hidden>Back</button><button type="submit" class="journey-button journey-submit">Send Your Scenario</button></div>
        </fieldset>
        <p class="journey-status" role="status" tabindex="-1" hidden></p>
