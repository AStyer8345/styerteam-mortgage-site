        <fieldset data-journey-step="1"><legend>Your plans</legend><div class="journey-fields"><div class="journey-field"><label for="business_owner-loan_goal">What would you like to do?</label><select id="business_owner-loan_goal" name="loan_goal"><option value="Not Sure Yet" selected>Not Sure Yet</option><option value="Purchase">Purchase</option><option value="Refinance">Refinance</option><option value="Access equity">Access equity</option><option value="Invest">Invest</option><option value="Build">Build</option><option value="Buy before selling">Buy before selling</option></select></div>
<div class="journey-field"><label for="business_owner-income_type">What should I know about your situation?</label><select id="business_owner-income_type" name="income_type"><option value="No special circumstance">No special circumstance</option><option value="Self-employed / business owner" selected>Self-employed / business owner</option><option value="Rental income">Rental income</option><option value="Substantial assets">Substantial assets</option><option value="Difficulty with another lender">Difficulty with another lender</option><option value="Another circumstance">Another circumstance</option><option value="Not sure yet">Not sure yet</option></select></div>
<div class="journey-field"><label for="business_owner-readiness">Where are you in the process?</label><select id="business_owner-readiness" name="readiness"><option value="">Choose or leave unknown</option><option value="Exploring">Exploring</option><option value="Comparing options">Comparing options</option><option value="Property identified">Property identified</option><option value="Under contract">Under contract</option></select></div>
<div class="journey-field"><label for="business_owner-property_value">Approximate price or property value</label><input id="business_owner-property_value" name="property_value" type="text" maxlength="160" placeholder="Estimate or leave unknown"></div>
