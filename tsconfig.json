{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "@netlify/functions"]
  },
  "include": ["netlify/functions/**/*.ts", "tests/assistant/**/*.ts"]
}
