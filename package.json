{
  "name": "styerteam-mortgage-site",
  "version": "1.0.0",
  "private": true,
  "description": "Adam Styer | HyperSmart Home Loans website with newsletter automation",
  "scripts": {
    "build": "npm run validate:knowledge && npm run audit:forms && (node scripts/gen-recent-updates.js || true)",
    "test": "node --test tests/*.test.js && tsx --test tests/assistant/*.test.ts",
    "audit:forms": "node scripts/audit-form-notifications.mjs",
    "seo:audit": "node scripts/seo-audit.mjs",
    "seo:registry": "node scripts/generate-seo-registry.mjs",
    "seo:gsc": "node scripts/gsc-snapshot.mjs",
    "typecheck": "tsc --noEmit",
    "validate:knowledge": "node scripts/validate-ai-knowledge.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@mailchimp/mailchimp_marketing": "^3.0.80",
    "@netlify/blobs": "^8.1.0"
  },
  "devDependencies": {
    "@netlify/functions": "^5.3.0",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
